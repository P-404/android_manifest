    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <!-- Device -->
  <project path="device/404/sepolicy" name="android_device_404_sepolicy" remote="p404" />
 
